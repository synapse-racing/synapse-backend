generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(uuid()) @map("_id")
  email        String           @unique
  username     String           @unique
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     RefreshSession[]
  trainingRuns TrainingRun[]

  @@map("users")
}

enum TrainingStatus {
  PAUSED
  RUNNING
  COMPLETED
}

model TrainingRun {
  id                String               @id @default(uuid()) @map("_id")
  userId            String
  name              String
  status            TrainingStatus       @default(PAUSED)
  seed              Int
  currentGeneration Int                  @default(0)
  bestFitness       Float                @default(0)
  config            Json
  bestGenome        Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  startedAt         DateTime?
  finishedAt        DateTime?
  user              User                 @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  checkpoints       TrainingCheckpoint[]
  metrics           GenerationMetric[]

  @@index([userId, updatedAt])
  @@map("training_runs")
}

model TrainingCheckpoint {
  id            String      @id @default(uuid()) @map("_id")
  trainingRunId String
  generation    Int
  snapshot      Json
  createdAt     DateTime    @default(now())
  trainingRun   TrainingRun @relation(fields: [trainingRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([trainingRunId, generation])
  @@map("training_checkpoints")
}

model GenerationMetric {
  id             String      @id @default(uuid()) @map("_id")
  trainingRunId  String
  generation     Int
  bestFitness    Float
  averageFitness Float
  speciesCount   Int
  durationMs     Int
  createdAt      DateTime    @default(now())
  trainingRun    TrainingRun @relation(fields: [trainingRunId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([trainingRunId, generation])
  @@map("generation_metrics")
}

model RefreshSession {
  id        String    @id @default(uuid()) @map("_id")
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}
